---
layout: base.njk
title: Projects
description: Personal and public projects built by James Davies.
---
<section class="section-spacer work-section">
  <div class="section-header">
    <h1 class="page-title">Projects</h1>
  </div>
  {% for project in projects %}
  <ul class="entry-list">
    <li class="entry-title">{{ project.name }}</li>
    {% if project.summary %}
    <li class="entry-summary">{{ project.summary }}</li>
    {% endif %}
    {% if project.details %}
    <li>
      <ul class="text-points">
        {% for detail in project.details %}
        <li>{{ detail }}</li>
        {% endfor %}
      </ul>
    </li>
    {% endif %}
    {% if project.stack %}
    <li class="entry-meta">{{ project.stack }}</li>
    {% endif %}
    {% if project.links and project.links.live %}
    <li>
      <a href="{{ project.links.live }}">{{ project.links.live }}</a>
    </li>
    {% endif %}
  </ul>
  {% endfor %}
</section>
