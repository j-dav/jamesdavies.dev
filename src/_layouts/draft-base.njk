<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% set metaTitle = title | default("Design draft") %}
    {% set metaDescription = description | default(site.description) %}
    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}" />
    <meta name="robots" content="noindex" />
    {% if fontUrls %}
      {% for fontUrl in fontUrls %}
    <link rel="stylesheet" href="{{ fontUrl }}" />
      {% endfor %}
    {% endif %}
    <link rel="stylesheet" href="{{ draftStylesheet }}" />
  </head>
  <body class="{{ draftBodyClass | default('') }}">
    <header class="draft-shell-header">
      <a href="/" aria-label="Go to homepage">jamesdavies.dev</a>
      <a href="/drafts">all drafts</a>
    </header>
    <main>
      {{ content | safe }}
    </main>
  </body>
</html>
