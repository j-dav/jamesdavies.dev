---
layout: draft-base.njk
title: Draft 2 · Editorial Case Study
description: Editorial case study style portfolio draft for a software engineer and founder.
permalink: /drafts/editorial/index.html
draftStylesheet: /styles/draft-editorial.css
fontUrls:
  - https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;700&display=swap
---
{% set latestWork = work[0] %}
{% set latestProject = projects[0] %}
<section class="editorial-hero">
  <p class="editorial-kicker">Draft 2 · Editorial Case Study</p>
  <h1>Engineering leadership with product judgement</h1>
  <p>
    I design dependable backend systems, lead practical delivery, and build
    focused products from first principle to launch.
  </p>
</section>

<section class="editorial-columns">
  <article class="editorial-panel">
    <h2>At a glance</h2>
    <ul>
      <li>{{ latestWork.role }}</li>
      <li>{{ latestWork.company }}</li>
      <li>{{ latestWork.dates }}</li>
    </ul>
  </article>

  <article class="editorial-panel">
    <h2>Selected impact</h2>
    {% if latestWork.details %}
    <ul>
      {% for detail in latestWork.details %}
      {% if loop.index <= 3 %}
      <li>{{ detail }}</li>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
  </article>
</section>

<section class="editorial-feature">
  <h2>Featured project: {{ latestProject.name }}</h2>
  <p>{{ latestProject.summary }}</p>
  {% if latestProject.details %}
  <p>{{ latestProject.details[0] }}</p>
  {% endif %}
  <div class="editorial-actions">
    <a href="/work">View full work history</a>
    {% if latestProject.links and latestProject.links.live %}
    <a href="{{ latestProject.links.live }}">Visit project</a>
    {% endif %}
  </div>
</section>
