---
layout: base.njk
title: Work
description: Career history and engineering experience of James Davies.
---
<section class="section-spacer work-section">
  <div class="section-header">
    <h1 class="page-title">Work</h1>
    <a href="/cv">View CV</a>
  </div>
  {% for entry in work %}
  <ul class="entry-list">
    <li class="entry-title">{{ entry.role }}</li>
    <li class="entry-subtitle">{{ entry.company }}</li>
    <li class="entry-meta">{{ entry.dates }}</li>
    {% if entry.summary or entry.details %}
    <li>
      {% if entry.summary %}
      <p class="entry-summary">{{ entry.summary }}</p>
      {% endif %}
      {% if entry.details %}
      <ul class="text-points">
        {% for detail in entry.details %}
        <li>{{ detail }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endif %}
  </ul>
  {% endfor %}
</section>
